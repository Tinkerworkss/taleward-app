+/* Eingabefelder: Fokus in Tinte, damit ein leeres Feld nicht wie ein Fehler aussieht (Rot bleibt für Achtung) */
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline-color: var(--ink);
+}
+
+/* Was vor dem Hauptknopf noch fehlt (components/Missing.tsx) */
+.missing {
+  color: var(--ink);
+  font-weight: 700;
+}
+
 @media (prefers-reduced-motion: reduce) {
@@ -246,2 +259,7 @@ h2 {
 
+/* Etwas ist zu tun, aber nichts Dringendes: ruhiger Strich in Tinte statt Rot (Rot nur für Achtung) */
+.card.task {
+  box-shadow: inset 4px 0 0 var(--tinte), var(--shadow-card);
+}
+
 /* Geheimes (nur SL): siegel-soft, Text in ink */
@@ -332,3 +350,3 @@ h2 {
   background: var(--paper-sunken);
-  border-color: transparent;
+  border-color: var(--line);
   color: var(--ink);
@@ -822,2 +840,32 @@ textarea {
 .fold-toggle[aria-expanded="true"] .fold-chevron { transform: rotate(90deg); }
+
+/* Alles Aufklappbare sieht gleich aus: ganze Zeile antippbar (48 px), Pfeil rechts, dreht beim Öffnen */
+details > summary {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 48px;
+  cursor: pointer;
+  list-style: none;
+}
+details > summary::-webkit-details-marker { display: none; }
+details > summary::after {
+  content: '›';
+  margin-left: auto;
+  flex-shrink: 0;
+  width: 1em;
+  text-align: center;
+  font-size: 1.25em;
+  line-height: 1;
+  color: var(--ink-faint);
+  transition: transform 150ms ease;
+}
+details[open] > summary::after { transform: rotate(90deg); }
+/* Eingeklappte Karte: nur die Zeile, kein Leerraum darunter */
+details.card { padding-top: 4px; padding-bottom: 4px; }
+details.card:not([open]) { gap: 0 !important; }
+details.card[open] { padding-bottom: var(--space-4); }
+@media (prefers-reduced-motion: reduce) {
+  details > summary::after, .fold-chevron { transition: none; }
+}
 .clamp-4 {

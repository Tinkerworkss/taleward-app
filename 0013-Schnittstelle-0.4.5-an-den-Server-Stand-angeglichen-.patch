From 7997aeffe9a3d0427f592eaa6dad593e2985ed04 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 11:01:25 +0200
Subject: [PATCH] Schnittstelle 0.4.5 an den Server-Stand angeglichen, Hinweis
 beim Verwerfen korrigiert
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Übernimmt die Präzisierungen des Servers: audioRetention immer vorhanden (höchstens 7 Tage, Zurücksetzen der
Zustimmungen beim Verlängern), 409 campaign_archived auch für Terminabstimmungen, Details beim Verlassen und
Zurückkommen, Rollenwechsel, Titelvergleich beim Löschen und Aufrücken der Kapitelnummern beim Verwerfen.
Die Rückfrage beim Verwerfen nennt jetzt das Aufrücken statt einer frei werdenden Nummer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/session-chronik-api.yaml | 37 +++++++++++++++++++++++------------
 src/i18n/en.ts                |  2 +-
 src/pages/Processing.tsx      |  2 +-
 3 files changed, 26 insertions(+), 15 deletions(-)

diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index 975a67b..a4677b1 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -118,7 +118,9 @@ info:
     Änderungen in 0.4.3: CoverPreset um 19 Titelbilder erweitert (dark-fantasy bis riverside-mystery), bestehende
     IDs unverändert.
     Änderungen in 0.4.4: ServerInfo.audioRetention – wie lange das Session-Audio bleibt; die App nennt es im
-    Einwilligungstext (dauerhaft und vor Ort), dazu den Cloud-Dienst, falls die Kampagne ihn erlaubt.
+    Einwilligungstext (dauerhaft und vor Ort), dazu den Cloud-Dienst, falls die Kampagne ihn erlaubt. Wird die
+    Aufbewahrung in der Verwaltung verlängert, setzt der Server recordingConsentAt aller Mitglieder zurück; die App
+    fragt dann mit dem neuen Wortlaut erneut.
     Änderungen in 0.4.5: Kampagnen abschließen (PATCH archived, CampaignSummary.archivedAt) und löschen
     (DELETE /campaigns/{id}), Mitglied entfernen bzw. selbst verlassen (DELETE …/members/{memberId}, Member.leftAt),
     Regeln für Rollenwechsel (last_gm), unveröffentlichtes Kapitel verwerfen (DELETE /sessions/{id}).
@@ -625,7 +627,8 @@ paths:
       summary: Kampagne endgültig löschen (nur SL, ab 0.4.5)
       description: |
         Löscht alles für alle: Kapitel, Recaps, Transkripte, Aufnahmen, Bibel, Unterlagen, Kommentare, Bilder, Termine.
-        confirmTitle muss dem Titel entsprechen (400 confirmation_mismatch). Nicht rückgängig zu machen.
+        confirmTitle muss dem Titel entsprechen (400 confirmation_mismatch; Groß-/Kleinschreibung und doppelte
+        Leerzeichen zählen nicht). Nicht rückgängig zu machen. Das Zustimmungsprotokoll bleibt als Nachweis.
       requestBody:
         required: true
         content:
@@ -675,7 +678,8 @@ paths:
                   type: boolean
                   description: |
                     true = abschließen (archivedAt gesetzt): nur noch lesen und kommentieren, keine neuen Kapitel
-                    (POST …/sessions → 409 campaign_archived), keine Terminabstimmung; false = wieder aufnehmen (ab 0.4.5)
+                    (POST …/sessions → 409 campaign_archived), keine Terminabstimmung (POST …/date-poll → 409
+                    campaign_archived; eine offene wird abgebrochen); false = wieder aufnehmen (ab 0.4.5)
                 system:
                   oneOf:
                     - { $ref: "#/components/schemas/GameSystem" }
@@ -724,9 +728,10 @@ paths:
       tags: [Kampagnen]
       summary: Mitglied entfernen (SL) oder die Kampagne selbst verlassen (eigene memberId) (ab 0.4.5)
       description: |
-        Das Mitglied bleibt mit leftAt stehen (wie ein gelöschtes Konto), Kommentare bleiben; es verliert den Zugriff
-        (für die Person dann 404). Stehende Zustimmung und Charakter-Hintergrund werden gelöscht. Die letzte aktive SL
-        kann weder gehen noch entfernt werden (409 last_gm). Wer über eine neue Einladung zurückkommt, wird wieder aktiv.
+        Das Mitglied bleibt mit leftAt stehen (wie ein gelöschtes Konto), Kommentare und Charakterbild bleiben; es
+        verliert den Zugriff (für die Person dann 404). Stehende Zustimmung (Widerruf wird protokolliert), Charakter-
+        Hintergrund, Terminstimmen und Lesemarker werden gelöscht. Die letzte aktive SL kann weder gehen noch entfernt
+        werden (409 last_gm). Wer über eine neue Einladung zurückkommt, wird als Spieler wieder aktiv (gleiche memberId).
       responses:
         "204": { description: Entfernt bzw. verlassen }
         "401": { $ref: "#/components/responses/Unauthorized" }
@@ -736,6 +741,9 @@ paths:
     patch:
       tags: [Kampagnen]
       summary: Charaktername oder Rolle ändern (Rolle nur durch SL)
+      description: |
+        Die letzte aktive SL kann nicht zum Spieler werden (409 last_gm). Wer SL wird, sieht ab sofort alles Geheime
+        der Kampagne.
       requestBody:
         required: true
         content:
@@ -1008,7 +1016,8 @@ paths:
       summary: Unveröffentlichtes Kapitel verwerfen (nur SL, ab 0.4.5)
       description: |
         Löscht Session samt Upload-Teilen, Audio, Transkript, Hörproben, Vorschlägen und Recap-Entwurf; laufende Aufträge
-        werden abgebrochen. Veröffentlichte Kapitel → 409 session_published. Die Kapitelnummer wird wieder frei.
+        werden abgebrochen. Veröffentlichte Kapitel → 409 session_published. Die Kapitelnummer wird wieder frei: spätere
+        Kapitel rücken um eins auf (App lädt die Kapitelliste danach neu).
       responses:
         "204": { description: Verworfen }
         "401": { $ref: "#/components/responses/Unauthorized" }
@@ -1470,7 +1479,7 @@ paths:
           content: { application/json: { schema: { $ref: "#/components/schemas/Error" } } }
     post:
       tags: [Termine]
-      summary: Terminabstimmung starten (nur SL; 409 `date_poll_open`, wenn schon eine läuft)
+      summary: Terminabstimmung starten (nur SL; 409 `date_poll_open`, wenn schon eine läuft; 409 `campaign_archived`)
       requestBody:
         required: false
         content:
@@ -1979,15 +1988,17 @@ components:
         appDownloadSha256: { type: [string, "null"], description: "SHA-256 (hex) der APK unter appDownloadUrl – nur, wenn der Server die Datei selbst anbietet (ab 0.4.1)" }
         appDownloadSizeBytes: { type: [integer, "null"], description: "Größe der APK in Bytes (ab 0.4.1)" }
         audioRetention:
-          type: [object, "null"]
+          type: object
           description: |
             Wie lange das Session-Audio auf dem Server bleibt (ab 0.4.4, Einstellung in der Verwaltung). until_release =
-            bis die SL den Recap veröffentlicht, höchstens maxDays Tage (Standard 7), danach löscht ein geplanter Job es
-            und setzt audioDeletedAt. immediate = gleich nach der Transkription. Hörproben pro Sprecher und Stimmprofile
-            sind davon unabhängig. Fehlt das Feld (ältere Server), geht die App von immediate aus.
+            bis die SL den Recap veröffentlicht, höchstens maxDays Tage (Standard für neue Server: 7), danach löscht ein
+            geplanter Job es und setzt audioDeletedAt. immediate = gleich nach der Transkription (maxDays null).
+            Hörproben pro Sprecher und Stimmprofile sind davon unabhängig. Ab 0.4.4 immer vorhanden; fehlt das Feld
+            (ältere Server), geht die App von immediate aus. Wird die Aufbewahrung verlängert (immediate → until_release
+            oder mehr Tage), setzt der Server recordingConsentAt aller Mitglieder zurück.
           properties:
             mode: { type: string, enum: [until_release, immediate] }
-            maxDays: { type: [integer, "null"], minimum: 1, example: 7 }
+            maxDays: { type: [integer, "null"], minimum: 1, maximum: 7, example: 7 }
         authProviders:
           type: array
           description: Eingerichtete Anmeldedienste (ab 0.4.0) – die App zeigt genau diese Knöpfe. Leer = keine.

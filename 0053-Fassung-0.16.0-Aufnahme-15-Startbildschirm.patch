 package.json            |  2 +-
 scripts/screenshots.mjs | 20 ++++++++++++++++----
 3 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/package-lock.json b/package-lock.json
index da485bb..3f3db59 100644

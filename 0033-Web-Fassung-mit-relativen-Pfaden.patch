From 66166b376ad1abd30d530225cab2bd58f912a653 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Wed, 7 Oct 2026 06:41:50 +0200
Subject: [PATCH] Web-Fassung mit relativen Pfaden

Dieselbe Web-Fassung laeuft jetzt unter /app/ und an der Wurzel einer
eigenen Adresse. Der Rueckweg nach dem Anmelden mit einem Dienst nimmt
den Pfad der geladenen Seite.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018aiEzsk3JkKj9Ft8xrcuW2
---
 .env.web         | 4 ++--
 src/auth/oidc.ts | 4 +++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/.env.web b/.env.web
index 8dbd63a..fdd0ae2 100644
--- a/.env.web
+++ b/.env.web
@@ -1,4 +1,4 @@
-# Web-Fassung unter /app/ (zentrale Taleward-Website oder eigener Server)
+# Web-Fassung mit relativen Pfaden: läuft unter /app/ (eigener Server) und an der Wurzel einer eigenen Subdomain
 VITE_API_MODE=real
 VITE_DIST=web
-VITE_BASE=/app/
+VITE_BASE=./
diff --git a/src/auth/oidc.ts b/src/auth/oidc.ts
index c2bae2c..fda39a8 100644
--- a/src/auth/oidc.ts
+++ b/src/auth/oidc.ts
@@ -60,7 +60,9 @@ export async function startProviderLogin(opts: {
   localStorage.setItem(PENDING, JSON.stringify(pending));
   // Im Browser (Web-Fassung) zurück auf diese Seite statt auf taleward:// – nur erlaubte Ziele nimmt der Server an
   const web = !Capacitor.isNativePlatform() && !MOCK;
-  const returnTo = web ? `${window.location.origin}${import.meta.env.BASE_URL}#/auth` : null;
+  // Pfad der geladenen Seite statt fester Basis: dieselbe Web-Fassung läuft unter /app/ und an der Wurzel
+  const path = window.location.pathname.replace(/index\.html$/, '');
+  const returnTo = web ? `${window.location.origin}${path}#/auth` : null;
   const q = new URLSearchParams({ challenge, purpose: opts.purpose, ...(linkToken ? { linkToken } : {}), ...(returnTo ? { returnTo } : {}) });
   const url = `${opts.baseUrl}/auth/oidc/${opts.provider}/start?${q}`;
 

+    if (pcs.length && m.role === 'player') {
+      (gmNotices[c.id] ??= []).push({ id: 'gn-' + crypto.randomUUID().slice(0, 8), code: 'character_orphaned', memberId: m.id, entryIds: pcs.map((e) => e.id), createdAt: new Date().toISOString() });

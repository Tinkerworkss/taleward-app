-/* Schirm einrichten */
-.table-chooser {
-  display: grid;
-  gap: 12px;
-  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
-}
-
-.table-chooser-col {
+/* Schirm einrichten: Raster sichtbar, Karten ziehen und an der Ecke vergrößern */
+.table-edit-bar {
   display: flex;
-  flex-direction: column;
+  flex-wrap: wrap;
+  align-items: center;
   gap: 8px;
-  margin: 0;
-  padding: 10px;
-  border: 1px solid var(--line);
+}
+
+.table-edit-name {
+  font: 700 15px/20px var(--font-sans);
+}
+
+.table-edit-group {
+  display: inline-flex;
+  gap: 4px;
+}
+
+.table-grid.editing {
+  touch-action: none;
+  user-select: none;
+}
+
+.table-cell {
+  border: 1px dashed var(--line);
   border-radius: 10px;
@@ -1559,13 +1560,65 @@ details.card[open] { padding-bottom: var(--space-4); }
 
-.table-chooser-col legend {
-  font: 700 14px/20px var(--font-sans);
-  padding: 0 4px;
+.table-edit-card {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  min-width: 0;
+  min-height: 0;
+  background: var(--paper-raised);
+  border: 1.5px solid var(--line-strong);
+  border-radius: 12px;
+  box-shadow: var(--shadow-card);
+  cursor: grab;
 }
 
-.table-chooser-card {
+.table-edit-card.selected {
+  border: 3px solid var(--tinte);
+}
+
+.table-edit-card.dragging {
+  z-index: 2;
+  opacity: 0.9;
+  cursor: grabbing;
+}
+
+.table-edit-card.blocked {
+  border: 3px dashed var(--siegel);
+}
+
+.table-edit-select {
+  flex: 1;
   display: flex;
   flex-direction: column;
+  align-items: center;
+  justify-content: center;
   gap: 4px;
-  padding-bottom: 6px;
-  border-bottom: 1px dashed var(--line);
+  min-height: 48px;
+  padding: 8px;
+  background: none;
+  border: 0;
+  color: var(--ink);
+  font: inherit;
+  cursor: inherit;
+}
+
+.table-edit-resize {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  width: 48px;
+  height: 48px;
+  cursor: nwse-resize;
+  background:
+    linear-gradient(135deg, transparent 0 55%, var(--line-strong) 55% 60%, transparent 60% 70%, var(--line-strong) 70% 75%, transparent 75%);
+  border-bottom-right-radius: 12px;
+}
+
+[data-theme='dark'] .table-edit-card.selected {
+  border-color: var(--on-tinte);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) .table-edit-card.selected {
+    border-color: var(--on-tinte);
+  }
 }

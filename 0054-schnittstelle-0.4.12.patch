+  /documents/{documentId}/file:
+    parameters: [{ $ref: "#/components/parameters/documentId" }]
+    get:
+      tags: [Unterlagen]
+      summary: Originaldatei einer Unterlage (ab 0.4.12; nur SL, bei character_sheet auch die Urheberin, sonst 404)
+      description: |
+        Zum Nachlesen während der Runde (SL-Schirm). Antwortet mit dem gespeicherten Inhalt und passendem Content-Type,
+        `Content-Disposition: inline; filename="…"` und `Cache-Control: no-store`. Unterlagen bleiben auf dem Server
+        der Kampagne; die App speichert sie nicht dauerhaft.
+      responses:
+        "200":
+          description: Datei
+          content:
+            application/pdf: { schema: { type: string, format: binary } }
+            application/octet-stream: { schema: { type: string, format: binary } }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+
+  /documents/{documentId}/text:
+    parameters: [{ $ref: "#/components/parameters/documentId" }]
+    get:
+      tags: [Unterlagen]
+      summary: Erkannter Text einer Unterlage, je Seite (ab 0.4.12; Rechte wie …/file)
+      description: |
+        Der Text, den der Server bei der Auswertung ohnehin gewinnt, mit Seitenzahlen. Die App zeigt ihn lesbar in einer
+        Spalte und durchsucht ihn. Ist (noch) kein Text vorhanden (Auswertung läuft, eingescannte Seiten ohne

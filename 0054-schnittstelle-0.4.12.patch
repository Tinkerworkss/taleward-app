@@ -2796,2 +2935,67 @@ components:
 
+    ChapterPlanInput:
+      type: object
+      properties:
+        title: { type: string, minLength: 1, maxLength: 120 }
+        sessionNumber:
+          type: [integer, "null"]
+          minimum: 1
+          description: Für welches Kapitel (Nummer der Session). null = noch keinem Kapitel zugeordnet.
+        state:
+          type: string
+          enum: [draft, ready, played]
+          description: |
+            Nur Anzeige für die SL. Wird eine Session mit derselben Nummer veröffentlicht, setzt der Server `played`
+            (die SL kann es zurücksetzen).
+        notes: { type: [string, "null"], maxLength: 20000, description: Freie Notiz der SL zum ganzen Kapitel }
+        scenes:
+          type: array
+          maxItems: 50
+          items: { $ref: "#/components/schemas/PlanScene" }
+        names:
+          type: array
+          maxItems: 100
+          items: { type: string, maxLength: 40 }
+          description: |
+            Namen, die in diesem Kapitel vorkommen werden. Einzige Verbindung des Plans zur KI: Bei der Transkription der
+            Session mit derselben sessionNumber kommen sie zusätzlich zu Campaign.hotwords in die Schreibhilfe – nur die
+            Wörter, nie Inhalte des Plans.
+        documentIds:
+          type: array
+          maxItems: 20
+          items: { type: string }
+          description: Verknüpfte SL-Unterlagen dieser Kampagne (unbekannte IDs → 400 invalid_input; gelöschte fallen heraus)
+
+    ChapterPlan:
+      description: |
+        Kapitelplan (ab 0.4.12). Verbindlich:
+        - Nur für die SL. Für Spieler gibt es keinen Weg dorthin (404), keine Anzahl, keinen Hinweis.
+        - Der Plan fließt nie in Kapitel, Vorschläge, Gegenprüfung oder Probelauf. Ausnahme nur `names` (Schreibhilfe).
+        - Verknüpfte Bibel-Einträge ändern ihre Sichtbarkeit dadurch nicht; aufgedeckt wird wie bisher über
+          PATCH /entries/{id} (visibility).
+        - Beim Umzug gehen Pläne mit (wie SL-Unterlagen); entryIds und documentIds werden übersetzt.
+      allOf:
+        - $ref: "#/components/schemas/ChapterPlanInput"
+        - type: object
+          required: [id, campaignId, title, state, scenes, names, documentIds, createdAt, updatedAt]
+          properties:
+            id: { type: string }
+            campaignId: { type: string }
+            createdAt: { type: string, format: date-time }
+            updatedAt: { type: string, format: date-time }
+
+    PlanScene:
+      type: object
+      required: [id, title]
+      properties:
+        id: { type: string, description: UUID; neue Szenen bringt die App mit eigener ID }
+        title: { type: string, minLength: 1, maxLength: 120 }
+        notes: { type: [string, "null"], maxLength: 4000 }
+        entryIds:
+          type: array
+          maxItems: 30
+          items: { type: string }
+          description: Bibel-Einträge dieser Kampagne, die in der Szene eine Rolle spielen (gelöschte fallen heraus)
+        state: { type: string, enum: [open, played, skipped], default: open }
+
     CoverPreset:

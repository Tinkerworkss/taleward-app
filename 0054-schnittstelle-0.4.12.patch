+                        page: { type: integer, minimum: 1, description: "Seite; bei .txt/.md/.docx fortlaufende Abschnitte" }
+                        text: { type: string }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+
+  /campaigns/{campaignId}/plans:
+    parameters: [{ $ref: "#/components/parameters/campaignId" }]
+    get:
+      tags: [Kapitelplan]
+      summary: Kapitelpläne der Kampagne (ab 0.4.12; nur SL – für alle anderen 404)
+      description: |
+        Sortiert nach sessionNumber (ohne Nummer zuletzt), dann nach createdAt. Spieler erfahren nie, ob es Pläne gibt

+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: "#/components/schemas/ChapterPlanInput" }
+      responses:
+        "201":
+          description: Angelegt
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/ChapterPlan" }
+        "400": { $ref: "#/components/responses/BadRequest" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+
+  /plans/{planId}:
+    parameters: [{ $ref: "#/components/parameters/planId" }]
+    get:
+      tags: [Kapitelplan]
+      summary: Ein Kapitelplan (nur SL, sonst 404)
+      responses:
+        "200":
+          description: OK
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/ChapterPlan" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+    patch:
+      tags: [Kapitelplan]
+      summary: Kapitelplan ändern (nur SL)
+      description: |
+        Nur mitgeschickte Felder ändern sich; `scenes`, `names` und `documentIds` werden jeweils als ganze Liste ersetzt
+        (Reihenfolge der Szenen = Reihenfolge der Liste). Neue Szenen schickt die App mit eigener UUID.
+        Gleichzeitige Änderung auf zwei Geräten: Mit `ifUpdatedAt` antwortet der Server 409 `conflict`, wenn der Plan
+        inzwischen geändert wurde; die App lädt dann neu.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              allOf:
+                - $ref: "#/components/schemas/ChapterPlanInput"

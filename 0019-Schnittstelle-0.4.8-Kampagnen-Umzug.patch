+        message: { type: [string, "null"], description: "z. B. Fehlertext bei failed" }
+        createdAt: { type: string, format: date-time }
+
+    ImportStatus:
+      type: object
+      description: Import einer Datei taleward-kampagne/1 (ab 0.4.8)
+      required: [id, state]
+      properties:
+        id: { type: string }
+        state: { type: string, enum: [uploading, processing, done, failed] }
+        progress: { type: [number, "null"], minimum: 0, maximum: 1 }
+        missingChunks: { type: array, items: { type: integer }, description: "nur bei uploading" }
+        campaignId: { type: [string, "null"], description: "bei done" }
+        openSeats: { type: [integer, "null"], description: "bei done: Zahl der offenen Plätze" }
+        message:
+          type: [string, "null"]
+          description: |
+            Bei failed ein fester Schlüssel: import_format (unbekanntes oder beschädigtes Format), import_too_large,
+            import_unsafe (unzulässige Pfade oder zu große entpackte Größe), import_version (Datei von einer neueren

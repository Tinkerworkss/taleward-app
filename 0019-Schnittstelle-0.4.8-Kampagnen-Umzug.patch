+    parameters:
+      - { name: importId, in: path, required: true, schema: { type: string } }
+      - { name: index, in: path, required: true, schema: { type: integer, minimum: 0 } }
+    put:
+      tags: [Umzug]
+      summary: Einen Teil hochladen (idempotent, ab 0.4.8)
+      parameters:
+        - name: X-Chunk-SHA256
+          in: header
+          required: false
+          description: Optional – SHA-256 des Teils (hex); falsch → 400 `chunk_checksum_mismatch`
+          schema: { type: string }
+      requestBody:
+        required: true
+        content:
+          application/octet-stream:
+            schema: { type: string, format: binary }
+      responses:
+        "204": { description: Teil gespeichert }
+        "400": { $ref: "#/components/responses/BadRequest" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409": { $ref: "#/components/responses/Conflict" }
+        "413": { $ref: "#/components/responses/PayloadTooLarge" }
+
+  /imports/{importId}/complete:
+    parameters:
+      - { name: importId, in: path, required: true, schema: { type: string } }
+    post:
+      tags: [Umzug]
+      summary: Upload abschließen – Server prüft und legt die Kampagne an (ab 0.4.8)
+      description: |
+        Prüft die ZIP (Pfade, entpackte Gesamtgröße, Format), kodiert Bilder neu, prüft Unterlagen wie beim normalen
+        Hochladen und legt eine neue, aktive Kampagne mit neuen IDs an. Die importierende Person wird einzige SL; alle
+        Plätze der Datei werden offene Plätze (openSeat), Ehemalige kommen mit leftAt. Kapitelnummern bleiben.
+      responses:
+        "202":
+          description: Prüfung läuft
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/ImportStatus" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409":
+          description: Es fehlen noch Teile (details.missingChunks)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Error" }
+
+  /campaigns/{campaignId}/members/{memberId}/invite:
+    parameters:
+      - { $ref: "#/components/parameters/campaignId" }
+      - { $ref: "#/components/parameters/memberId" }
+    post:
+      tags: [Umzug]
+      summary: Einladung für genau diesen offenen Platz (nur SL, ab 0.4.8)
+      description: |
+        Für Plätze, die keine passende characterId abholt (Altbestand ohne Sammlung). Der Code gilt einmal und nur für
+        diesen Platz; wer damit beitritt (POST /campaigns/join), sitzt auf dem Platz, mit oder ohne Charakter.
+        Kein offener Platz → 409 seat_not_open.
+      responses:
+        "201":
+          description: Code erzeugt
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  code: { type: string }
+                  expiresAt: { type: string, format: date-time }
+                  memberId: { type: string }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409": { $ref: "#/components/responses/Conflict" }
+
+  /campaigns/{campaignId}/members/{memberId}/take:
+    parameters:
+      - { $ref: "#/components/parameters/campaignId" }
+      - { $ref: "#/components/parameters/memberId" }
+    post:
+      tags: [Umzug]
+      summary: „Das bin ich“ – die importierende SL setzt sich auf ihren alten Platz (ab 0.4.8)
+      description: |
+        Nur die Person, die importiert hat (sonst 403 not_importer), nur offene Plätze (sonst 409 seat_not_open). Das
+        beim Import angelegte Mitglied geht im Platz auf; der Platz hat danach die Rolle gm.
+      responses:
+        "200":
+          description: Die Kampagne mit aktualisierter Mitgliederliste
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Campaign" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409": { $ref: "#/components/responses/Conflict" }
+
+  /campaigns/{campaignId}/members/{memberId}/release:
+    parameters:
+      - { $ref: "#/components/parameters/campaignId" }
+      - { $ref: "#/components/parameters/memberId" }
+    post:
+      tags: [Umzug]
+      summary: Eingenommenen Platz wieder freigeben (nur SL, ab 0.4.8)
+      description: |
+        Macht einen Platz wieder offen, z. B. wenn sich jemand auf den falschen gesetzt hat. Die Person verliert den
+        Zugriff und kann mit einer neuen Einladung neu beitreten. Die letzte aktive SL kann nicht freigegeben werden
+        (409 last_gm).
+      responses:
+        "200":
+          description: Der Platz (openSeat true)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Member" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409": { $ref: "#/components/responses/Conflict" }
+

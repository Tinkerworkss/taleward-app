+  /campaigns/{campaignId}/members/me/move-consent:
+    parameters: [{ $ref: "#/components/parameters/campaignId" }]
+    put:
+      tags: [Umzug]
+      summary: Zustimmung, dass die eigenen Charakterdaten bei einem Umzug mitgehen (ab 0.4.8)
+      description: |
+        Nur für sich selbst. Zustimmung und Widerruf werden protokolliert. Ohne Zustimmung geht nur der Platz mit
+        (Rolle, characterId, Charaktername). Mit Zustimmung zusätzlich Kurzbeschreibung, Hintergrund, Spitzname,
+        Status und Fassung des Charakters, Porträt, eigene öffentliche Kommentare, Charakterbögen; private Kommentare
+        nur, wenn beide Beteiligten zugestimmt haben.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [granted]
+              properties:
+                granted: { type: boolean }
+      responses:
+        "200":
+          description: Eigenes Mitglied
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Member" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+
+  /campaigns/{campaignId}/exports:
+    parameters: [{ $ref: "#/components/parameters/campaignId" }]
+    post:
+      tags: [Umzug]
+      summary: Kampagne als Datei taleward-kampagne/1 packen (nur SL, ab 0.4.8)
+      description: |
+        Läuft als Auftrag auf dem Server (ohne Worker). Die Datei enthält gm_only-Inhalte und geht nur an die SL.
+        Nie in der Datei: Anzeige- und Benutzernamen, E-Mail-Adressen, Konten, Einwilligungen, Stimmprofile,
+        Transkripte, Hörproben, Audio, Recap.review, Vorschläge, Terminabstimmungen, Lesemarker, Nutzung, gmNotices.
+        Unveröffentlichte Kapitel gehen nicht mit. Der Export ändert nichts an der Kampagne. Spieler 404.
+      responses:
+        "202":
+          description: Gestartet
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/CampaignExport" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "409":
+          description: Es läuft schon ein Export (`export_running`)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Error" }
+
+  /campaigns/{campaignId}/exports/{exportId}:
+    parameters:
+      - { $ref: "#/components/parameters/campaignId" }
+      - { name: exportId, in: path, required: true, schema: { type: string } }
+    get:
+      tags: [Umzug]
+      summary: Stand des Exports (nur SL, ab 0.4.8; die App fragt alle paar Sekunden)
+      responses:
+        "200":
+          description: OK
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/CampaignExport" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+
+  /campaigns/{campaignId}/exports/{exportId}/file:
+    parameters:
+      - { $ref: "#/components/parameters/campaignId" }
+      - { name: exportId, in: path, required: true, schema: { type: string } }
+    get:
+      tags: [Umzug]
+      summary: Datei herunterladen (nur SL, ab 0.4.8)
+      description: |
+        application/zip, Content-Disposition mit Dateiname `taleward-kampagne-<titel>-<datum>.zip`, Unterstützung für
+        Range-Anfragen. Mit Bearer-Token oder mit dem Parameter `t` aus CampaignExport.downloadUrl (ohne Token, damit
+        Browser und Android-Downloadmanager große Dateien direkt auf die Platte laden können).
+      parameters:
+        - name: t
+          in: query
+          required: false
+          description: Download-Schlüssel aus CampaignExport.downloadUrl; gilt bis expiresAt, nur für diese Datei
+          schema: { type: string }
+      responses:
+        "200":
+          description: Die Datei
+          content:
+            application/zip:
+              schema: { type: string, format: binary }
+        "206": { description: Teil der Datei (Range) }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "404": { $ref: "#/components/responses/NotFound" }
+        "410":
+          description: Datei schon gelöscht (`export_expired`)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Error" }
+
+  /imports:
+    post:
+      tags: [Umzug]
+      summary: Import einer Datei taleward-kampagne/1 beginnen (jede angemeldete Person, ab 0.4.8)
+      description: |
+        Stückweiser Upload wie bei Aufnahmen. Größte Datei stellt der Betreiber ein (Standard 1 GB). Nicht
+        abgeschlossene Importe löscht der Server nach 7 Tagen.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [fileName, sizeBytes]
+              properties:
+                fileName: { type: string }
+                sizeBytes: { type: integer, minimum: 1 }
+      responses:
+        "201":
+          description: Angelegt
+          content:
+            application/json:
+              schema:
+                type: object
+                required: [importId, chunkSizeBytes, chunkCount]
+                properties:
+                  importId: { type: string }
+                  chunkSizeBytes: { type: integer, example: 5242880 }
+                  chunkCount: { type: integer }
+        "400": { $ref: "#/components/responses/BadRequest" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "413":
+          description: Datei zu groß (`import_too_large`, details.maxBytes)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/Error" }
+
+  /imports/{importId}:
+    parameters:
+      - { name: importId, in: path, required: true, schema: { type: string } }

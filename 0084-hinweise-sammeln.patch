+  position: absolute;
+  right: 0;
+  bottom: 0;
+  width: 48px;
+  height: 48px;
+  display: grid;
+  place-items: center;
+  border: 0;
+  border-radius: 50%;
+  background: var(--tinte);
+  color: var(--on-tinte, #fff);
+  cursor: pointer;
+}
+.revision-send:disabled { opacity: 0.5; }
+.revision-self { margin-left: auto; }
+.paragraph-hint { margin-top: 2px; }
+.revision-tip { flex-basis: 100%; }
+/* Absätze zum Antippen (ab 0.4.15): ganz leise Rückmeldung, kein Rahmen */

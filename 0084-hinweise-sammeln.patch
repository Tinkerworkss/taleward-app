+/* Die ruhige Zeile: nur ein Strich darunter, Pfeil rechts erst mit Text */
+.revision-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
+.revision-input { position: relative; flex: 1 1 220px; }
+.revision-input textarea {
+  display: block;
+  width: 100%;
+  min-height: 48px;
+  resize: none;
+  overflow: hidden;
+  background: none;
+  border: 0;
+  border-bottom: 1px solid var(--line-strong);
